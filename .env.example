# Environment Variables for Machine Learning Projects
# =================================================

# Hugging Face Hub Token
# Get your token from: https://huggingface.co/settings/tokens
# Used for accessing models, datasets, and uploading to Hugging Face Hub
HUGGINGFACE_HUB_TOKEN=your_huggingface_token_here
HF_TOKEN=your_huggingface_token_here

# Kaggle API Credentials
# Get these from: https://www.kaggle.com/settings -> API -> Create New API Token
# This downloads a kaggle.json file with your username and key
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here

# OpenAI API Key (if needed for projects)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Weights & Biases (wandb) API Key (if using for experiment tracking)
# Get from: https://wandb.ai/settings
WANDB_API_KEY=your_wandb_api_key_here

# CUDA/GPU Settings (optional)
CUDA_VISIBLE_DEVICES=0

# Python Path (if needed)
PYTHONPATH=/mnt/Storage02/SoftwareDev/CAP_6411_Assignments

# =================================================
# Instructions:
# 1. Replace the placeholder values with your actual tokens
# 2. Never commit this file to version control with real tokens
# 3. Add .env to your .gitignore file
# 4. Load in Python using: from dotenv import load_dotenv; load_dotenv()
# =================================================